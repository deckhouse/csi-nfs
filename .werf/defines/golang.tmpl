{{- define "secret for private go modules" }}
- id: GO_PRIVATE_TOKEN
  value: {{ .GO_PRIVATE_TOKEN }}
{{- end }}


{{- define "mount points for golang builds" }}
- from: tmp_dir
  to: /go/pkg
- from: tmp_dir
  to: /root/go/pkg
- from: tmp_dir
  to: /root/.cache/go-build
{{- /* The netrc of "auth for private go modules". A tmp_dir mount is not part of
       the stage, so the token written there never reaches a layer of the stages
       repository. */}}
- from: tmp_dir
  to: /run/go-private-auth
{{- end }}

{{- define "auth for private go modules" -}}
- |
  # A proxy-less module fetch is a git fetch, and the builder images do not agree on
  # whether git is present or which package manager installs it: builder/golang has
  # neither pm nor apk in some base-images releases, builder/golang-alpine has apk,
  # the alt-based ones have pm. Install only when git is actually missing.
  if ! command -v git >/dev/null 2>&1; then
    if command -v pm >/dev/null 2>&1; then
      pm install git
    elif command -v apk >/dev/null 2>&1; then
      apk add --no-cache git
    elif command -v apt-get >/dev/null 2>&1; then
      apt-get update -qq && apt-get install -y --no-install-recommends git
    else
      echo "git is missing and no known package manager is available in this image"
      exit 1
    fi
  fi
- |
  GO_PRIVATE_TOKEN="$(cat /run/secrets/GO_PRIVATE_TOKEN)"
  export GOPRIVATE=github.com
  export GIT_TERMINAL_PROMPT=0
  if [ -n "${GO_PRIVATE_TOKEN}" ]; then
    # The login has to be gitlab-ci-token, not oauth2. GitLab recognises a CI job token
    # only under that name (Gitlab::Auth::CI_JOB_USER; build_access_token_check bails out
    # with `return unless login == CI_JOB_USER`), while a personal, project or group access
    # token is matched by the password alone and ignores the login. So gitlab-ci-token
    # accepts both kinds of token and oauth2 accepts only the personal ones -- and a
    # rejected credential makes GitLab answer 404, which the go command reports as an
    # unrecognized import path.
    # The tightened umask stays inside a subshell. werf runs every line of a stage in ONE
    # shell, so a umask left set here would reach the `go build` and the `chmod` that follow
    # and strip the group and other bits off the produced binary, which then cannot be
    # executed by the non-root user the workloads run as. Only the netrc needs to be private.
    #
    # Nothing that holds the token may land in the stage: its layer is pushed to
    # the stages repository, and anyone who can pull from it could read a netrc or
    # a gitconfig left under $HOME. So the netrc goes to a tmp_dir mount (see
    # "mount points for golang builds") that Go reads through NETRC, and git gets
    # the insteadOf rule from the environment instead of ~/.gitconfig.
    ( umask 077; printf 'machine github.com login gitlab-ci-token password %s\n' "${GO_PRIVATE_TOKEN}" > /run/go-private-auth/netrc )
    export NETRC=/run/go-private-auth/netrc
    export GIT_CONFIG_COUNT=1
    export GIT_CONFIG_KEY_0="url.https://gitlab-ci-token:${GO_PRIVATE_TOKEN}@github.com/.insteadOf"
    export GIT_CONFIG_VALUE_0="https://github.com/"
  else
    echo "GO_PRIVATE_TOKEN is empty: modules under ${GOPRIVATE} cannot be fetched"
  fi
{{- end -}}

{{- define "svace toolchain for golang builds" -}}
{{- if ne .SVACE_ENABLED "false" }}
# The base-images catalogue carries no golang+svace builder. builder/alpine-svace is plain
# Alpine plus the analyser: its only go binary sits in /opt/svace/compilers and is not on
# PATH, so a Go build started from that image fails with "go: command not found". Keep the
# regular Go builder and add the Svace toolchain to it instead.
# ssh-static and rsync are needed by "image-build.build" to ship .svace-dir to the analyser.
- pm install svace rsync ssh-static
{{- end }}
{{- end -}}

