set -Eeo pipefail

PREFIX="/var/lib/deckhouse/sds/csi-nfs"
RPCBIND_UNIT="d8-csi-nfs-rpcbind.service"
STATD_UNIT="d8-csi-nfs-rpc-statd.service"

# statd first: it is registered with the portmapper and unregistering is the
# polite half of stopping.
for unit in "${STATD_UNIT}" "${RPCBIND_UNIT}"; do
  systemctl disable --now "${unit}" || true
  rm -f "/etc/systemd/system/${unit}"
done
systemctl daemon-reload || true

# Only the files this install put on the host, never the host's own: the link
# rpc.statd execs sm-notify through. A directory it created is worth taking back
# too, but only while it is empty; rmdir tells the two apart on its own.
HOST_FILES="${PREFIX}/host-files.list"
if [[ -f "${HOST_FILES}" ]]; then
  dirs=""
  while read -r placed; do
    [[ -n "${placed}" ]] || continue
    rm -f "${placed}"
    dirs="${dirs} $(dirname "${placed}")"
  done < "${HOST_FILES}"
  for dir in ${dirs}; do
    rmdir "${dir}" 2>/dev/null || true
  done
fi

# /var/lib/nfs is deliberately left in place. Its sm/sm.bak lists are the record
# of which peers hold locks on this node, and a distribution package installed
# later expects to find them where they are.
rm -rf "${PREFIX}"
