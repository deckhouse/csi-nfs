From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "v.oleynikov" <vasily.oleynikov@flant.com>
Date: Sat, 26 Sep 2026 08:15:47 +0300
Subject: [PATCH 2/5] Add mountPermissions to snapshot, fix mountPermissions

Accept mountPermissions in the VolumeSnapshotClass and apply it to the snapshot directory, fail CreateVolume when chmod of the volume directory fails, and do not chmod the node publish target (the root of the NFS export). Ported onto v4.13.4, which already uses syscall.Chmod for raw Unix modes.

Signed-off-by: v.oleynikov <vasily.oleynikov@flant.com>
---
 pkg/nfs/controllerserver.go | 30 +++++++++++++++++++++++++++++-
 pkg/nfs/nodeserver.go       |  9 +++++----
 2 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/pkg/nfs/controllerserver.go b/pkg/nfs/controllerserver.go
index d96a661b..e16c91b6 100644
--- a/pkg/nfs/controllerserver.go
+++ b/pkg/nfs/controllerserver.go
@@ -188,7 +188,7 @@ func (cs *ControllerServer) CreateVolume(ctx context.Context, req *csi.CreateVol
 	if mountPermissions > 0 {
 		// Reset directory permissions because of umask problems
 		if err := chmodIfPermissionMismatch(internalVolumePath, uint32(mountPermissions)); err != nil {
-			klog.Warningf("failed to chmod subdirectory: %v", err)
+			return nil, status.Error(codes.Internal, err.Error())
 		}
 	}
 
@@ -395,6 +395,16 @@ func (cs *ControllerServer) CreateSnapshot(ctx context.Context, req *csi.CreateS
 	if err := validateSnapshot(snapInternalVolPath, snapshot, cs.Driver.enableSnapshotCompression); err != nil {
 		return nil, err
 	}
+	mountPermissionsForSnapInternalVolPath, err := getMountPermissionsForSnapInternalVolPath(req.GetParameters())
+	if err != nil {
+		return nil, status.Errorf(codes.NotFound, "failed to get mountPermissionsForSnapInternalVolPath: %v", err)
+	} else {
+		if mountPermissionsForSnapInternalVolPath > 0 {
+			if err := chmodIfPermissionMismatch(snapInternalVolPath, uint32(mountPermissionsForSnapInternalVolPath)); err != nil {
+				return nil, status.Error(codes.Internal, err.Error())
+			}
+		}
+	}
 
 	if err = cs.internalMount(ctx, srcVol, req.GetParameters(), volCap); err != nil {
 		return nil, status.Errorf(codes.Internal, "failed to mount src nfs server: %v", err)
@@ -685,6 +695,8 @@ func newNFSSnapshot(name string, params map[string]string, vol *nfsVolume) (*nfs
 			baseDir = v
 		case mountOptionsField:
 			// no op
+		case mountPermissionsField:
+			// no op
 		default:
 			return nil, status.Errorf(codes.InvalidArgument, "invalid parameter %q in snapshot storage class", k)
 		}
@@ -941,3 +953,19 @@ func volumeFromSnapshot(snap *nfsSnapshot) *nfsVolume {
 		uuid:    snap.uuid,
 	}
 }
+
+// getMountPermissionsForSnapInternalVolPath Convert VolumeSnapshot parameters to a snapInternalVolPath
+func getMountPermissionsForSnapInternalVolPath(params map[string]string) (uint64, error) {
+	mountPermissions := uint64(0)
+	for k, v := range params {
+		if strings.ToLower(k) == mountPermissionsField {
+			if v != "" {
+				var err error
+				if mountPermissions, err = strconv.ParseUint(v, 8, 32); err != nil {
+					return 0, status.Errorf(codes.InvalidArgument, "invalid mountPermissions %s in storage class", v)
+				}
+			}
+		}
+	}
+	return mountPermissions, nil
+}
diff --git a/pkg/nfs/nodeserver.go b/pkg/nfs/nodeserver.go
index 23d0ab0a..45bef7dc 100644
--- a/pkg/nfs/nodeserver.go
+++ b/pkg/nfs/nodeserver.go
@@ -127,7 +127,7 @@ func (ns *NodeServer) NodePublishVolume(_ context.Context, req *csi.NodePublishV
 	notMnt, err := ns.mounter.IsLikelyNotMountPoint(targetPath)
 	if err != nil {
 		if os.IsNotExist(err) {
-			if err := os.MkdirAll(targetPath, os.FileMode(mountPermissions)); err != nil {
+			if err := os.MkdirAll(targetPath, 0777); err != nil {
 				return nil, status.Error(codes.Internal, err.Error())
 			}
 			notMnt = true
@@ -168,9 +168,10 @@ func (ns *NodeServer) NodePublishVolume(_ context.Context, req *csi.NodePublishV
 	}
 
 	if mountPermissions > 0 {
-		if err := chmodIfPermissionMismatch(targetPath, uint32(mountPermissions)); err != nil {
-			return nil, status.Error(codes.Internal, err.Error())
-		}
+		klog.V(2).Infof("skip chmod on targetPath(%s), as there is no need to change the root directory of the nfs server", targetPath)
+		//if err := chmodIfPermissionMismatch(targetPath, uint32(mountPermissions)); err != nil {
+		//	return nil, status.Error(codes.Internal, err.Error())
+		//}
 	} else {
 		klog.V(2).Infof("skip chmod on targetPath(%s) since mountPermissions is set as 0", targetPath)
 	}
