+
+type mountTimeoutError struct {
+	source  string
+	target  string
+	timeout time.Duration
+}
+
+func (e *mountTimeoutError) Error() string {
+	return fmt.Sprintf("mount volume %s to %s timeout after %ds", e.source, e.target, int(e.timeout/time.Second))
