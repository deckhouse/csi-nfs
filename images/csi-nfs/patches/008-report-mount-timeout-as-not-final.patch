+	"google.golang.org/grpc/status"
+	mount "k8s.io/mount-utils"
+)
+
+func TestNodePublishVolumeTimeoutIsNotFinal(t *testing.T) {
+	saved := mountTimeout
+	mountTimeout = 50 * time.Millisecond
+	t.Cleanup(func() { mountTimeout = saved })
+
+	fake := mount.NewFakeMounter(nil)
+	mounter := &hangingMounter{Interface: fake, release: make(chan struct{})}
+	ns := NewNodeServer(NewEmptyDriver(""), mounter)
+
+	target := testutil.GetWorkDirPath("timed_out_mount_target", t)
+	t.Cleanup(func() { _ = mount.CleanupMountPoint(target, fake, true) })
+
+	_, err := ns.NodePublishVolume(context.Background(), publishRequest(target))
+	assert.Equal(t, codes.DeadlineExceeded, status.Code(err), "a mount still running past its timeout may yet succeed, so kubelet must not treat it as failed")
+	assert.ErrorContains(t, err, "timeout after")
+	_, statErr := os.Stat(target)
+	assert.NoError(t, statErr, "the target path is left for the mount that is still running")
+
+	close(mounter.release)
+	assert.Eventually(t, func() bool {
+		_, running := ns.mounts.running("vol_1-" + target)
+		return !running
+	}, 5*time.Second, 10*time.Millisecond)
+
+	_, err = ns.NodePublishVolume(context.Background(), publishRequest(target))
+	assert.NoError(t, err, "a retry finds the mount that finished past its timeout")
+	assert.Equal(t, int32(1), mounter.calls.Load(), "the late mount is used, not repeated")
+}
+
+func TestNodePublishVolumeFailedMountIsFinal(t *testing.T) {
+	fake, err := NewFakeMounter()
+	assert.NoError(t, err)
+	ns := NewNodeServer(NewEmptyDriver(""), &failingMounter{Interface: fake})
+
+	target := testutil.GetWorkDirPath("failed_in_time_mount_target", t)
+	t.Cleanup(func() { _ = mount.CleanupMountPoint(target, fake, true) })
+
+	_, err = ns.NodePublishVolume(context.Background(), publishRequest(target))
+	assert.Equal(t, codes.Internal, status.Code(err))
+}
