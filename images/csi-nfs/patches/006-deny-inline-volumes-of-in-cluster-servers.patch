+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package nfs
+
+import (
+	"errors"
+	"net"
+	"testing"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func TestCheckInlineServer(t *testing.T) {
+	nets, err := ParseCIDRs("10.111.0.0/16, 10.222.0.0/16,")
+	if err != nil || len(nets) != 2 {
+		t.Fatalf("ParseCIDRs: %v %v", nets, err)
+	}
+	if _, err := ParseCIDRs("10.0.0.0/33"); err == nil {
+		t.Fatal("a bad CIDR is accepted")
+	}
+
+	lookupIP = func(host string) ([]net.IP, error) {
+		switch host {
+		case "nfs-shared.d8-sds-nfs.svc":
+			return []net.IP{net.ParseIP("10.222.3.4")}, nil
+		case "nas.example.com":
+			return []net.IP{net.ParseIP("192.168.1.10")}, nil
+		}
+		return nil, errors.New("no such host")
+	}
+	defer func() { lookupIP = net.LookupIP }()
+
+	d := &Driver{deniedInlineNets: nets}
+	inline := map[string]string{ephemeralContextKey: "true"}
+	cases := []struct {
+		name    string
+		context map[string]string
+		server  string
+		denied  bool
+	}{
+		{"service address", inline, "10.222.1.1", true},
+		{"pod address", inline, "10.111.5.6", true},
+		{"name of a service", inline, "nfs-shared.d8-sds-nfs.svc", true},
+		{"server outside the cluster", inline, "nas.example.com", false},
+		{"address outside the cluster", inline, "192.168.1.20", false},
+		{"unresolvable name", inline, "nowhere", true},
+		{"persistent volume", map[string]string{}, "10.222.1.1", false},
+	}
+	for _, c := range cases {
+		err := d.checkInlineServer(c.context, c.server)
+		if (err != nil) != c.denied {
+			t.Fatalf("%s: denied=%v, err=%v", c.name, c.denied, err)
+		}
+		if err != nil && status.Code(err) != codes.PermissionDenied {
+			t.Fatalf("%s: code %v", c.name, status.Code(err))
+		}
+	}
+
+	if err := (&Driver{}).checkInlineServer(inline, "10.222.1.1"); err != nil {
+		t.Fatalf("no denied networks configured: %v", err)
+	}
+}
