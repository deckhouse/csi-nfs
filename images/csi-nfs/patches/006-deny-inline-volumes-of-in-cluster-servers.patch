+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package nfs
+
+import (
+	"fmt"
+	"net"
+	"strings"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// ephemeralContextKey is set by kubelet in the volume context of an inline
+// CSI volume when the CSIDriver asks for pod info on mount.
+const ephemeralContextKey = "csi.storage.k8s.io/ephemeral"
+
+var lookupIP = net.LookupIP
+
+// ParseCIDRs parses a comma-separated list of CIDRs; empty items are skipped.
+func ParseCIDRs(list string) ([]*net.IPNet, error) {
+	var nets []*net.IPNet
+	for _, item := range strings.Split(list, ",") {
+		item = strings.TrimSpace(item)
+		if item == "" {
+			continue
+		}
+		_, n, err := net.ParseCIDR(item)
+		if err != nil {
+			return nil, fmt.Errorf("parsing CIDR %q: %w", item, err)
+		}
+		nets = append(nets, n)
+	}
+	return nets, nil
+}
+
+// checkInlineServer refuses an inline volume whose server is inside the
+// cluster networks. The node plugin mounts from the node, and an NFS server
+// in the cluster admits the nodes: an inline volume would give any pod that
+// knows the address of such a server every directory it exports, the
+// volumes of other namespaces included. A PersistentVolume of its
+// StorageClass is the way to mount it.
+func (d *Driver) checkInlineServer(volumeContext map[string]string, server string) error {
+	if len(d.deniedInlineNets) == 0 || volumeContext[ephemeralContextKey] != "true" {
+		return nil
+	}
+	host := strings.TrimSuffix(strings.TrimPrefix(server, "["), "]")
+	ips := []net.IP{net.ParseIP(host)}
+	if ips[0] == nil {
+		var err error
+		if ips, err = lookupIP(host); err != nil {
+			return status.Errorf(codes.PermissionDenied, "an inline volume cannot mount server %s: it does not resolve (%v), so it cannot be told apart from a server inside the cluster", server, err)
+		}
+	}
+	for _, ip := range ips {
+		for _, n := range d.deniedInlineNets {
+			if n.Contains(ip) {
+				return status.Errorf(codes.PermissionDenied, "an inline volume cannot mount server %s: it is at %s, inside the cluster network %s; mount it through a PersistentVolume of its StorageClass", server, ip, n)
+			}
+		}
+	}
+	return nil
+}
