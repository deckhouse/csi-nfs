+// mountWithTimeout mounts the volume and gives up waiting after mountTimeout. A mount
+// that is still running then is recorded until its process exits, so that retries
+// do not start one mount process after another while the first one hangs.
+func (ns *NodeServer) mountWithTimeout(key, source, target string, options []string) error {
+	started := time.Now()
+	done := make(chan error, 1)
+	go func() {
+		done <- ns.mounter.Mount(source, target, "nfs", options)
+	}()
+
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(mountTimeout):
+	}
+
+	ns.mounts.add(key, started)
+	go func() {
+		err := <-done
+		ns.mounts.done(key)
+		took := time.Since(started).Round(time.Second)
+		if err != nil {
+			klog.Warningf("NodePublishVolume: the mount of %s on %s failed %s after it started, past its timeout: %v", source, target, took, err)
+			return
+		}
+		klog.Warningf("NodePublishVolume: the mount of %s on %s succeeded %s after it started, past its timeout", source, target, took)
+	}()
+	return fmt.Errorf("mount volume %s to %s timeout after %ds", source, target, int(mountTimeout/time.Second))
+}
