+package nfs
+
+import (
+	"maps"
+	"sync"
+	"time"
+)
+
+// mountTracker remembers the mounts that outlived the timeout of NodePublishVolume. The
+// mount process of such a mount keeps running after the call has returned, and with a
+// hard NFS mount it may never finish; a retry that started another one would only add
+// a process stuck in the kernel.
+type mountTracker struct {
+	mu      sync.Mutex
+	started map[string]time.Time
+}
+
+func newMountTracker() *mountTracker {
+	return &mountTracker{started: map[string]time.Time{}}
+}
+
+func (t *mountTracker) running(key string) (time.Time, bool) {
+	if t == nil {
+		return time.Time{}, false
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	at, ok := t.started[key]
+	return at, ok
+}
+
+func (t *mountTracker) add(key string, at time.Time) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.started[key] = at
+}
+
+func (t *mountTracker) done(key string) {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	maps.DeleteFunc(t.started, func(k string, _ time.Time) bool { return k == key })
+}
