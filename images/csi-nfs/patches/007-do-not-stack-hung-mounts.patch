+
+package nfs
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/container-storage-interface/spec/lib/go/csi"
+	"github.com/kubernetes-csi/csi-driver-nfs/test/utils/testutil"
+	"github.com/stretchr/testify/assert"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	mount "k8s.io/mount-utils"
+)
+
+type hangingMounter struct {
+	mount.Interface
+	release chan struct{}
+	calls   atomic.Int32
+}
+
+func (m *hangingMounter) Mount(source, target, fstype string, options []string) error {
+	m.calls.Add(1)
+	<-m.release
+	return m.Interface.Mount(source, target, fstype, options)
+}
+
+type failingMounter struct {
+	mount.Interface
+	calls atomic.Int32
+}
+
+func (m *failingMounter) Mount(_, _, _ string, _ []string) error {
+	m.calls.Add(1)
+	return errors.New("mount.nfs: Connection refused")
+}
+
+func publishRequest(target string) *csi.NodePublishVolumeRequest {
+	return &csi.NodePublishVolumeRequest{
+		VolumeId:         "vol_1",
+		TargetPath:       target,
+		VolumeCapability: &csi.VolumeCapability{AccessMode: &csi.VolumeCapability_AccessMode{Mode: csi.VolumeCapability_AccessMode_MULTI_NODE_MULTI_WRITER}},
+		VolumeContext:    map[string]string{"server": "server", "share": "share"},
+	}
+}
+
+func TestNodePublishVolumeHungMountBlocksOnlyItsTarget(t *testing.T) {
+	saved := mountTimeout
+	mountTimeout = 50 * time.Millisecond
+	t.Cleanup(func() { mountTimeout = saved })
+
+	fake, err := NewFakeMounter()
+	assert.NoError(t, err)
+	mounter := &hangingMounter{Interface: fake, release: make(chan struct{})}
+	t.Cleanup(func() { close(mounter.release) })
+	ns := NewNodeServer(NewEmptyDriver(""), mounter)
+
+	first := testutil.GetWorkDirPath("hung_mount_first", t)
+	second := testutil.GetWorkDirPath("hung_mount_second", t)
+	t.Cleanup(func() {
+		_ = mount.CleanupMountPoint(first, fake, true)
+		_ = mount.CleanupMountPoint(second, fake, true)
+	})
+
+	_, err = ns.NodePublishVolume(context.Background(), publishRequest(first))
+	assert.ErrorContains(t, err, "timeout after")
+
+	_, err = ns.NodePublishVolume(context.Background(), publishRequest(second))
+	assert.NotEqual(t, codes.Aborted, status.Code(err), "the same volume on another target path is not held by the hung mount")
+	assert.Equal(t, int32(2), mounter.calls.Load())
+}
+
+func TestNodePublishVolumeRetriesAMountThatFailed(t *testing.T) {
+	fake, err := NewFakeMounter()
+	assert.NoError(t, err)
+	mounter := &failingMounter{Interface: fake}
+	ns := NewNodeServer(NewEmptyDriver(""), mounter)
+
+	target := testutil.GetWorkDirPath("failed_mount_target", t)
+	t.Cleanup(func() { _ = mount.CleanupMountPoint(target, fake, true) })
+
+	for range 2 {
+		_, err = ns.NodePublishVolume(context.Background(), publishRequest(target))
+		assert.Equal(t, codes.Internal, status.Code(err))
+	}
+	assert.Equal(t, int32(2), mounter.calls.Load(), "a mount that failed within its timeout is not remembered")
+	_, running := ns.mounts.running("vol_1-" + target)
+	assert.False(t, running)
+}
+
+func TestNodePublishVolumeDoesNotStackHungMounts(t *testing.T) {
+	saved := mountTimeout
+	mountTimeout = 50 * time.Millisecond
+	t.Cleanup(func() { mountTimeout = saved })
+
+	fake, err := NewFakeMounter()
+	assert.NoError(t, err)
+	mounter := &hangingMounter{Interface: fake, release: make(chan struct{})}
+	ns := NewNodeServer(NewEmptyDriver(""), mounter)
+
+	target := testutil.GetWorkDirPath("hung_mount_target", t)
+	t.Cleanup(func() { _ = mount.CleanupMountPoint(target, fake, true) })
+	publish := &csi.NodePublishVolumeRequest{
+		VolumeId:         "vol_1",
+		TargetPath:       target,
+		VolumeCapability: &csi.VolumeCapability{AccessMode: &csi.VolumeCapability_AccessMode{Mode: csi.VolumeCapability_AccessMode_MULTI_NODE_MULTI_WRITER}},
+		VolumeContext:    map[string]string{"server": "server", "share": "share"},
+	}
+
+	_, err = ns.NodePublishVolume(context.Background(), publish)
+	assert.ErrorContains(t, err, "timeout after")
+
+	_, err = ns.NodePublishVolume(context.Background(), publish)
+	assert.Equal(t, codes.Aborted, status.Code(err))
+	assert.Contains(t, err.Error(), "has not finished")
+	assert.Equal(t, int32(1), mounter.calls.Load(), "a retry while the first mount hangs starts no other mount")
+
+	_, err = ns.NodeUnpublishVolume(context.Background(), &csi.NodeUnpublishVolumeRequest{VolumeId: "vol_1", TargetPath: target})
+	assert.NotEqual(t, codes.Aborted, status.Code(err), "a hung mount does not keep the pod from being torn down")
+
+	close(mounter.release)
+	assert.Eventually(t, func() bool {
+		_, running := ns.mounts.running("vol_1-" + target)
+		return !running
+	}, 5*time.Second, 10*time.Millisecond, "the hung mount is forgotten once its process exits")
+
+	_, err = ns.NodePublishVolume(context.Background(), publish)
+	if err != nil {
+		assert.False(t, strings.Contains(err.Error(), "has not finished"), err.Error())
+	}
+}
