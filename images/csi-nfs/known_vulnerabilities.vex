  "statements": [
    {
      "vulnerability": {
        "name": "CVE-2025-1767"
      },
      "products": [
        {
          "@id": "pkg:golang/k8s.io/kubernetes@v1.32.10"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Уязвимость затрагивает устаревший механизм in-tree gitRepo volume. В рамках csi-nfs создание таких томов невозможно, прав на создание таких томов у пользователя нет и уязвимость использоваться не может",
      "timestamp": "2026-09-26T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "GO-2026-5932"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto@v0.58.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "Advisory covers the unmaintained golang.org/x/crypto/openpgp subpackage. The csi-driver-nfs module requires golang.org/x/crypto only through its e2e test suite (k8s.io/kubernetes/test/e2e/framework/ssh -> golang.org/x/crypto/ssh); `go mod why golang.org/x/crypto/openpgp` reports the main module does not need the openpgp package, and no golang.org/x/crypto package is compiled into the csi-nfs binary. golang.org/x/crypto has no release that drops openpgp, so the finding cannot be resolved by upgrading.",
      "timestamp": "2026-09-26T00:00:00Z"
    }
  ],
  "timestamp": "2026-10-29T00:00:00Z"
}
